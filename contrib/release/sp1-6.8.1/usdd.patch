+//! Regression for GHSA-p7v2-jjv3-8p8f at the exact deserializer used by proofs.
+use slop_tensor::{Dimensions, Tensor};
+
+#[test]
+fn tensor_storage_must_match_declared_dimensions() {
+    for rows in 0..=4 {
+        for columns in 0..=4 {
+            for len in 0..=20 {
+                let mut tensor = Tensor::<u32>::from(vec![7; len]);
+                tensor.dimensions = Dimensions::try_from([rows, columns]).unwrap();
+                let bytes = bincode::serialize(&tensor).unwrap();
+                let decoded = bincode::deserialize::<Tensor<u32>>(&bytes);
+                assert_eq!(decoded.is_ok(), len == rows * columns,
+                    "storage={len}, shape={rows}x{columns}");
+                if let Ok(valid) = decoded {
+                    assert!(valid.has_valid_shape());
+                    assert_eq!(bincode::serialize(&valid).unwrap(), bytes);
+                }
+            }
+        }
+    }
+}
+
+#[test]
+fn dimension_product_overflow_is_rejected() {
+    for sizes in [[usize::MAX, 2, 1], [0, usize::MAX, 2], [2, usize::MAX, 0]] {
+        assert!(Dimensions::try_from(sizes).is_err());
+        let bytes = bincode::serialize(&sizes.to_vec()).unwrap();
+        assert!(bincode::deserialize::<Dimensions>(&bytes).is_err());
+    }
+}
