# Used at configure time and again before each build that links a verifier.
if(NOT IS_ABSOLUTE "${ARCHIVE}" OR NOT EXISTS "${ARCHIVE}" OR IS_DIRECTORY "${ARCHIVE}" OR IS_SYMLINK "${ARCHIVE}")
  message(FATAL_ERROR "Verifier archive must be an existing absolute non-symlink file: ${ARCHIVE}")
endif()
string(LENGTH "${EXPECTED_SHA256}" digest_length)
if(NOT digest_length EQUAL 64 OR NOT "${EXPECTED_SHA256}" MATCHES "^[0-9a-f]+$")
  message(FATAL_ERROR "A trusted, lowercase 64-hex SHA256 pin is required for ${ARCHIVE}")
endif()
# Thin archives leave object files outside the authenticated bytes.
file(READ "${ARCHIVE}" archive_magic LIMIT 8 HEX)
if(NOT archive_magic STREQUAL "213c617263683e0a")
  message(FATAL_ERROR "Verifier must be a self-contained ar archive (thin archives are forbidden): ${ARCHIVE}")
endif()
file(SHA256 "${ARCHIVE}" actual_sha256)
if(NOT actual_sha256 STREQUAL EXPECTED_SHA256)
  message(FATAL_ERROR "Verifier SHA256 mismatch: ${ARCHIVE}; expected ${EXPECTED_SHA256}, got ${actual_sha256}")
endif()
